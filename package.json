{
  "name": "inkstone-markdown-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "墨读：本地 Markdown 阅读、文件管理与批注扩展",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "package": "npm run build && python3 scripts/package.py"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "esbuild": "^0.25.11",
    "fake-indexeddb": "^6.2.4"
  }
}
